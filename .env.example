# ===== 采集参数 =====
# 盘中刷新间隔（秒）。15 是实测甜点：快速轮次只发 2 个请求，
# 全市场那 56 页按下面的 TTL 缓存，与这个值无关。
# 下限约 2 秒——完整采集本身要 6.4 秒，间隔更小会导致请求重叠堆积。
ASHARE_WATCH_REFRESH_SECONDS=15

# 非交易时段刷新间隔（秒）
ASHARE_WATCH_IDLE_SECONDS=900

# 全市场快照缓存时间（秒）。全市场约 5500 只、要翻 56 页，
# 占了总请求量的 97%，所以缓存松一点。它决定榜单/宽度/涨跌停的滞后时间。
ASHARE_WATCH_UNIVERSE_TTL=240

# 行业板块缓存时间（秒）
ASHARE_WATCH_SECTOR_TTL=300

# 指数日线历史缓存时间（秒）
ASHARE_WATCH_HISTORY_TTL=21600

# 并发请求数。实测 8 并发 + 连接复用最稳（再高容易被限流，新浪会返回 HTTP 456）
ASHARE_WATCH_WORKERS=8

ASHARE_WATCH_TIMEOUT=20
ASHARE_WATCH_RETRIES=3

# 服务监听地址与端口（用 8771，避免和美股看板冲突）
ASHARE_WATCH_HOST=127.0.0.1
ASHARE_WATCH_PORT=8771

# ===== 自选股 =====
# 逗号分隔的 6 位代码，留空使用默认列表
ASHARE_WATCH_SYMBOLS=

# 不自动打开浏览器
ASHARE_WATCH_NO_BROWSER=0
